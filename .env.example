# Browser origins allowed to call the API, comma-separated.
# 必须和浏览器地址栏里的源逐字一致——localhost 和 127.0.0.1 是两个源，
# 少写一个就是浏览器端「Failed to fetch」，而 curl 测不出来（curl 不管 CORS）。
# 部署到 Vercel 之后，把最终那个域名（预览域名或自有域名）也加进来。
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://heyjue.com

# OpenAI-compatible language model. If omitted, Current uses deterministic
# local rules so development and safety tests still work.
# 默认填的是智谱 GLM-4.7-Flash：长期免费，只限并发不限 token，够验证期用。
# 换 DeepSeek 就改成 https://api.deepseek.com/v1 + deepseek-v4-flash
# （注意 deepseek-chat 已于 2026-07-24 下线，别再用那个名字）。
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash

# Tencent Cloud realtime ASR. Audio goes from the browser directly to Tencent;
# this backend only returns a short-lived signed URL.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
ASR_APP_ID=
ASR_ENGINE_MODEL=16k_zh

# AMap Web Service key. Server-only: never expose this key in the HTML/client.
# Without it, recommendations keep using the prototype distance estimates.
AMAP_WEB_SERVICE_KEY=

# PostgreSQL. On Vercel, use the pooled DATABASE_URL supplied by Neon.
# If omitted, privacy-safe events are written only to runtime logs.
DATABASE_URL=
