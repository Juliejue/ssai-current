# Browser origins allowed to call the API, comma-separated.
ALLOWED_ORIGINS=http://localhost:8000,https://heyjue.com

# OpenAI-compatible language model. If omitted, Current uses deterministic
# local rules so development and safety tests still work.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Tencent Cloud realtime ASR. Audio goes from the browser directly to Tencent;
# this backend only returns a short-lived signed URL.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
ASR_APP_ID=
ASR_ENGINE_MODEL=16k_zh

# PostgreSQL. If omitted, privacy-safe events are written only to runtime logs.
DATABASE_URL=

